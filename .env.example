# Optional Docker Compose settings. Copy this file to .env to override defaults.
APP_PORT=8080

# false for local HTTP. Set true only when serving the public site over HTTPS.
AUTH_COOKIE_SECURE=false

# By default both localhost and 127.0.0.1 with APP_PORT are allowed.
# Set this explicitly for another public origin, without a trailing slash.
# Multiple origins can be separated by commas.
# AUTH_ALLOWED_ORIGINS=https://ai-ana.example.com
