            "title": "Status"
          },
          "catalog_version": {
            "type": "string",
            "title": "Catalog Version"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          },
          "origin": {
            "type": "string",
            "enum": [
              "original",
              "team",
              "demo"
