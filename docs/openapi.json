            "title": "Origin"
          },
          "profile_count": {
            "type": "integer",
            "title": "Profile Count"
          },
          "calendar": {
            "$ref": "#/components/schemas/CalendarWindow"
          },
          "dictionaries": {
            "$ref": "#/components/schemas/CatalogDictionaries"
          },
          "quality": {
            "$ref": "#/components/schemas/QualityStats"
          },
          "city_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "City Counts"
          },
          "category_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Category Counts"
          }
        },
        "type": "object",
        "required": [
          "status",
          "catalog_version",
          "source_sha256",
          "origin",
          "profile_count",
          "calendar",
          "dictionaries",
          "quality",
          "city_counts",
          "category_counts"
        ],
        "title": "CatalogMetadata"
      },
      "DataWarning": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "evidence": {
            "anyOf": [
