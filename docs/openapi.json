            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "profile_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Value"
          },
          "requested_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Value"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "display_is_cleaned": {
            "type": "boolean",
            "title": "Display Is Cleaned",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "code",
          "field",
          "text"
        ],
        "title": "Evidence"
      },
      "Exclusion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "reasons": {
            "items": {
              "type": "string",
