# Пути относительно корня репозитория, независимо от текущей папки запуска.
# Переменные необходимо экспортировать в окружение; .env не читается автоматически.
CATALOG_PATH="hackathon dataset anonymized .csv"
CATALOG_ORIGIN=original

# Аккаунты и сессии. Для Docker этот каталог нужно сохранять в volume.
AUTH_DB_PATH=data/auth/accounts.sqlite3
# Включить true при публикации за HTTPS.
AUTH_COOKIE_SECURE=false
# Публичный адрес сайта; несколько адресов через запятую.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Предусмотрено ТЗ для отдельного этапа NVIDIA. Сейчас приложение эти параметры
# НЕ читает: адаптер не реализован, заполнение не включает внешние вызовы.
# AI_PROVIDER=none
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=
# NVIDIA_REQUEST_TIMEOUT_SECONDS=15
# NVIDIA_MAX_RETRIES=1
