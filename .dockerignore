# Only source files required by the two images enter the build context.
**
!.dockerignore
!backend/
!backend/Dockerfile
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
!frontend/Dockerfile
!frontend/nginx.conf
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!hackathon dataset anonymized .csv

# Keep local credentials, accounts and generated files out, even inside source.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.sqlite*
**/__pycache__
**/*.pyc
**/*.pyo
**/node_modules
**/dist
**/test-results
**/playwright-report
**/.git
